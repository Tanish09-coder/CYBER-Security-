# =============================================================================
# CyberRiskOS Backend — Environment Configuration Template
# Phase 9 — Release Readiness
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in real values.
#            .env must NEVER be committed to source control.
#            This file (.env.example) contains ONLY safe placeholders.
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# In-memory mode for offline testing: memory://
DATABASE_URL=postgresql://cyberadmin:CHANGE_ME_IN_PRODUCTION@localhost:5432/cyberriskos

# PostgreSQL credentials (used in docker-compose only)
POSTGRES_USER=cyberadmin
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=cyberriskos

# --- Security ---
# JWT_SECRET: Required. Must be a cryptographically random string >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_REQUIRED_GENERATE_WITH_OPENSSL_OR_CRYPTO_RANDOM_32_BYTES

# CORS: Comma-separated list of trusted frontend origins (required in production)
# Example: https://cyberriskos.yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- NVD API ---
# Leave NVD_API_KEY empty to use public rate-limited mode (6 req/30s)
# Register at https://nvd.nist.gov/developers/request-an-api-key for 50 req/30s
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_TIMEOUT_MS=15000
NVD_MAX_RETRIES=4
NVD_REQUEST_DELAY_MS=600

# --- CISA KEV ---
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CISA_KEV_TIMEOUT_MS=15000
CISA_KEV_MAX_RETRIES=4
CISA_KEV_STALE_AFTER_HOURS=24

# --- MITRE ATT&CK ---
MITRE_ATTACK_INDEX_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/index.json
MITRE_ATTACK_ENTERPRISE_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json
MITRE_ATTACK_TIMEOUT_MS=30000
MITRE_ATTACK_MAX_RETRIES=4
MITRE_ATTACK_STALE_AFTER_HOURS=168

# --- VCDB / VERIS ---
VCDB_ZIP_URL=https://raw.githubusercontent.com/vz-risk/VCDB/master/data/joined/vcdb.json.zip
VCDB_TIMEOUT_MS=60000
VCDB_MAX_RETRIES=4
VCDB_STALE_AFTER_HOURS=168

# --- Python Risk Engine (internal service) ---
# In Docker: http://risk-engine:8000
# Local dev:  http://localhost:8000
RISK_ENGINE_URL=http://localhost:8000
RISK_ENGINE_TIMEOUT_MS=10000

# --- AI Explanation Assistant ---
# Provider: TEMPLATE (no API key needed) or OPENAI
AI_EXPLANATION_PROVIDER=TEMPLATE
# Required only when AI_EXPLANATION_PROVIDER=OPENAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_EXPLANATION_TIMEOUT_MS=15000
