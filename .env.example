# CyberRiskOS Backend Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Use real connection string: postgresql://cyberadmin:cyberpassword@localhost:5432/cyberriskos
# Or in-memory for testing / offline demo: memory://
DATABASE_URL=postgresql://cyberadmin:cyberpassword@localhost:5432/cyberriskos

# National Vulnerability Database (NVD) API v2.0
# Leave NVD_API_KEY empty to use public rate-limited mode
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_TIMEOUT_MS=15000
NVD_MAX_RETRIES=4
# Configurable request pacing delay in milliseconds (e.g. 600ms or 2000ms)
NVD_REQUEST_DELAY_MS=600

# CISA Known Exploited Vulnerabilities (KEV) Catalog
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CISA_KEV_TIMEOUT_MS=15000
CISA_KEV_MAX_RETRIES=4
CISA_KEV_STALE_AFTER_HOURS=24

# Security / JWT
JWT_SECRET=super-secret-development-token-change-in-production
